        "data": {
          "connection_mode": "Connection mode",
          "fallback_unit": "Fallback display unit",
          "idle_timeout": "Idle disconnect timeout"
        },
        "data_description": {
          "connection_mode": "Persistent stays connected for live height updates but keeps a Bluetooth connection slot busy. On demand connects only to send commands.",
          "fallback_unit": "Unit used to interpret height reports if the desk never reports its display unit. Pick the unit your keypad shows, or leave as none.",
          "idle_timeout": "On demand mode only: disconnect after this long without commands or movement."
        }
      }
    },
